# Optional: enables hosted auth/storage/database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Default: free local AI. Install Ollama and run: ollama pull qwen3:4b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional hosted provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Used to encrypt future extension pairing tokens.
APP_ENCRYPTION_KEY=
