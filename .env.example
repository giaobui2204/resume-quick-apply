# Optional: enables hosted accounts and cloud persistence.
NEXT_PUBLIC_SUPABASE_URL=
# Use the Supabase publishable key. The legacy anon key remains supported locally.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=false

# Private Postgres connection used only by scripts/import_dol_sponsorship.py or GitHub Actions.
# Never expose this value in a NEXT_PUBLIC variable or to browser code.
SUPABASE_DB_URL=

# Default: free local AI. Install Ollama and run: ollama pull qwen3:4b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional hosted provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Used to encrypt future extension pairing tokens.
APP_ENCRYPTION_KEY=

# Required only for the server-side delete-account endpoint.
# Keep server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
